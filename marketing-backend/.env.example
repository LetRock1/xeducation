# Copy this file to ".env" in the same folder and change what you need.
# Never commit the real .env.

# Login for the marketing dashboard (http://localhost:5174).
MARKETING_EMAIL=admin@xeducation.in
MARKETING_PASSWORD=change-me

# Secret used to sign dashboard logins - any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret between the two backends - must be IDENTICAL in user-backend/.env.
INTERNAL_API_KEY=change-me-to-another-random-string

# The user-backend's database (shared) and addresses.
USER_DB_PATH=../user-backend/xeducation_user.db
USER_BACKEND_URL=http://localhost:8000
USER_FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8001

# true: lead decay after 10 minutes of inactivity (instead of 7 days), for demos.
DEMO_MODE=true

# Real emails through Gmail (same as in user-backend/.env), or leave empty to print them.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: Google Gemini for the email coach.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
