# Copy this file to ".env" in the same folder and change what you need.
# Everything here is optional for a local demo; never commit the real .env.

# Real emails through Gmail (needs an App Password: Google Account > Security > App passwords).
# Leave both empty and every email is printed in the user-backend window instead ("[EMAIL MOCK]").
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Secret used to sign website logins - any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret between the two backends - must be IDENTICAL in marketing-backend/.env.
INTERNAL_API_KEY=change-me-to-another-random-string

# true: automations wait 1 minute (instead of 15-60) and "Run automations now" works without a key.
DEMO_MODE=true

# Next-best-action: share of decisions taken at random so the system keeps learning (0 to 1),
# and the most advisor calls it may create per day.
NBA_EXPLORE_RATE=0.15
NBA_DAILY_CALLS=20

# Sign-up / password-reset codes stay valid this many minutes.
OTP_EXPIRY_MINUTES=10

# Where links inside emails point.
USER_FRONTEND_URL=http://localhost:5173
MKT_PUBLIC_BASE_URL=http://localhost:8001

# Optional: Google Gemini writes chat answers and e-mail copy from the course facts.
# Leave empty to use the built-in templates (everything works without it).
GEMINI_API_KEY=
# Optional: a model name to try first. Leave empty: the CRM tries gemini-flash-latest,
# gemini-3.5-flash and gemini-2.5-flash and keeps the first one that answers.
GEMINI_MODEL=
